{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "番茄钟",
  "mainBinaryName": "pomodoro",
  "version": "2.0.0",
  "identifier": "com.pomodoro.fluent",
  "build": {
    "frontendDist": "m0"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "番茄钟",
        "width": 300,
        "height": 340,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../build/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
